APP_NAME=ProxWorld
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BRAND_COLOR=#16a34a
DEFAULT_CURRENCY=NGN

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proxworld
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=proxworld_session
ADMIN_SESSION_COOKIE=proxworld_admin_session

# --- Admin panel + reseller storefronts (config/proxworld.php) ---
# Change ADMIN_ROUTE_PREFIX to move the admin login off the guessable
# default "control-panel" — no code changes needed, just clear config cache.
ADMIN_ROUTE_PREFIX=control-panel
# Root domain reseller subdomains are appended to, e.g. a reseller with
# subdomain "acme" gets acme.proxworld.com. Defaults to APP_URL's host if left blank.
BASE_DOMAIN=

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Brevo (Sendinblue) transactional email ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@proxworld.test
BREVO_SENDER_NAME="ProxWorld"
MAIL_MAILER=brevo

# --- Flutterwave ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# --- Exchange rate provider ---
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# --- Telegram support link ---
SUPPORT_TELEGRAM_URL=https://t.me/proxworld_support

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# --- Cloudinary (newsletter/blog image + video uploads) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

VITE_APP_NAME="${APP_NAME}"
